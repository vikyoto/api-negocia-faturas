# Porta em que o servidor HTTP vai subir
PORT=3000

# Dados da bridge
BRIDGE_URL=https://url_da_bridge
BRIDGE_ACCESS_TOKEN=coloque_aqui_o_access_token_da_bridge

# Header Authorization que a bridge repassa para a API do cliente
# Coloque o valor completo, incluindo o prefixo "Bearer " se for o caso
CLIENTE_AUTHORIZATION=Bearer coloque_aqui_o_bearer_token_do_cliente

# Base da API real do cliente (usada para montar as URIs que vão dentro do body da bridge)
CLIENTE_BASE_URL=https://url_cliente

# Quantidade de dias de atraso a partir da qual uma fatura "Vencido" é considerada relevante
DIAS_LIMITE_ATRASO=15

# Chave simples para proteger este endpoint (a 11labs deve enviar no header x-api-key)
# Se deixar em branco, o endpoint fica sem proteção por chave (não recomendado em produção)
TOOL_API_KEY=defina_uma_chave_forte_aqui
